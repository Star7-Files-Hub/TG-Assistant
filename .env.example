# ===== TG-Assistant 环境变量 =====
# 完整文档：https://github.com/Star7-Files-Hub/TG-Assistant#配置参考

# --- 必填：Telegram API 凭据 ---
# 从 https://my.telegram.org 获取
TGA_API_ID=
TGA_API_HASH=

# --- 网络：代理（国内服务器必填）---
# 支持 socks5 / socks4 / http，可带认证
# TGA_PROXY=socks5://user:pass@127.0.0.1:1080
# TGA_PROXY=http://proxy.local:8080

# --- 通知：Bot 渠道（可选）---
# 从 @BotFather 获取 token；chat_id 填你的私聊或频道 id
# TGA_BOT_TOKEN=

# --- 运行参数 ---
# 日志级别：DEBUG / INFO / WARNING / ERROR
TGA_LOG_LEVEL=INFO
# pyrogram 自身日志级别（通常留 WARNING 即可）
TGA_PYROGRAM_LOG_LEVEL=WARNING
# 并发 worker 数（秒级转发建议 >= 4）
TGA_WORKERS=8
# FloodWait 睡眠阈值（秒），低于此值直接 sleep 而不是抛错
TGA_SLEEP_THRESHOLD=30
# 是否使用 IPv6
TGA_IPV6=0
